# LLM provider: openai | groq
LLM_PROVIDER=groq

# Groq (free tier) — recommended model for investigation JSON
GROQ_API_KEY=gsk-your-key-here
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI — used when LLM_PROVIDER=openai; also used for embeddings (semantic memory)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# TigerGraph local Docker (default)
TG_HOST=http://127.0.0.1:14240
TG_USERNAME=tigergraph
TG_PASSWORD=tigergraph
TG_GRAPHNAME=FraudInvestigationGraph
TG_TGCLOUD=false

# Optional token auth instead of username/password
# TG_API_TOKEN=your-token-here

# Optional agent path overrides
# AGENT_CASE_PACK_PATH=../DATA/filtered_data/case_pack.csv
# AGENT_OUTPUT_DIR=../cases
# AGENT_MODEL=openai/gpt-oss-120b
