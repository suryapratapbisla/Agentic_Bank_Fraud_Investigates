// ============================================================
// Entity: ClosedCase only. Does not load Card or Transaction.
//
// Source header (closed_cases_history.csv):
//   case_id, customer_id, card_id, opened_at, closed_at, outcome,
//   pattern, first_fraud_txn_id, txn_ids, n_txns, exposure_usd,
//   connected_card_ids, actions_taken, report_filed, analyst_notes,
//   ext_card_id, ext_connected_card_ids
//
// ext_* columns are generated by Scripts/Case_data.py for TG 4.2
// loader compatibility (avoid nested gsql_concat + flatten).
//
// Install:
//   gsql loading/load_closed_cases.gsql
//
// Run from graph/:
//   RUN LOADING JOB load_closed_cases USING f_closed_cases="../DATA/filtered_data/closed_cases_history.csv"
//   SHOW LOADING STATUS ALL
// ============================================================

USE GRAPH FraudInvestigationGraph

CREATE LOADING JOB load_closed_cases FOR GRAPH FraudInvestigationGraph {
    DEFINE FILENAME f_closed_cases = "/tmp/agentic_deploy/DATA/filtered_data/closed_cases_history.csv";

    LOAD f_closed_cases
        TO VERTEX ClosedCase VALUES (
            $"case_id",
            $"customer_id",
            $"card_id",
            $"opened_at",
            $"closed_at",
            $"outcome",
            $"pattern",
            $"first_fraud_txn_id",
            $"n_txns",
            $"exposure_usd",
            $"actions_taken",
            $"report_filed",
            $"analyst_notes"
        )
        WHERE $"case_id" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";

    LOAD f_closed_cases
        TO VERTEX Card VALUES (
            $"ext_card_id",
            $"customer_id",
            "",
            "",
            ""
        )
        WHERE $"ext_card_id" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";

    LOAD f_closed_cases
        TO TEMP_TABLE t_conn (case_id, ext_card_id)
        VALUES ($"case_id", flatten($"ext_connected_card_ids", "|", 1))
        WHERE $"ext_connected_card_ids" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";

    LOAD TEMP_TABLE t_conn
        TO VERTEX Card VALUES (
            $"ext_card_id",
            "",
            "",
            "",
            ""
        );

    LOAD TEMP_TABLE t_conn
        TO EDGE CONNECTED_TO VALUES ($"case_id", $"ext_card_id");

    LOAD f_closed_cases
        TO TEMP_TABLE t_txn (case_id, txn_id)
        VALUES ($"case_id", flatten($"txn_ids", "|", 1))
        WHERE $"txn_ids" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";

    LOAD TEMP_TABLE t_txn
        TO EDGE INVOLVES VALUES ($"case_id", $"txn_id");

    LOAD f_closed_cases
        TO EDGE ON_CARD VALUES ($"case_id", $"ext_card_id")
        WHERE $"case_id" != "" AND $"ext_card_id" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";
}

// RUN LOADING JOB load_closed_cases USING f_closed_cases="../DATA/filtered_data/closed_cases_history.csv"
