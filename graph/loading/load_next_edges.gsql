// ============================================================
// Load precomputed NEXT edges from filtered_data/next_edges.csv.
// Generated by Scripts/generate_next_edges.py after transaction load prep.
// ============================================================

USE GRAPH FraudInvestigationGraph

CREATE LOADING JOB load_next_edges FOR GRAPH FraudInvestigationGraph {
    DEFINE FILENAME f_next = "/tmp/agentic_deploy/DATA/filtered_data/next_edges.csv";

    LOAD f_next
        TO EDGE NEXT VALUES ($"from_txn", $"to_txn")
        USING HEADER="true", SEPARATOR=",", QUOTE="double";
}
