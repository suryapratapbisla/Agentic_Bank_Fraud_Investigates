// ============================================================
// Entity: Card only. Does not load Transaction.
//
// Canonical card key:
//   derived_card_id = "DRV::" + customer_id + card1..card6
// This is generated by Scripts/Case_data.py and included in
// transactions_with_identity_filtered.csv.
//
// External case card ids (e.g. C12382-K1) are not guaranteed to
// map 1:1 to this derived key. Keep those separate until mapping
// is verified.
//
// Install:
//   gsql loading/load_cards.gsql
//
// Run from graph/:
//   RUN LOADING JOB load_cards USING \
//     f_txns="../DATA/filtered_data/transactions_with_identity_filtered.csv"
//   SHOW LOADING STATUS ALL
// ============================================================

USE GRAPH FraudInvestigationGraph

CREATE LOADING JOB load_cards FOR GRAPH FraudInvestigationGraph {
    DEFINE FILENAME f_txns = "/tmp/agentic_deploy/DATA/filtered_data/transactions_with_identity_filtered.csv";

    LOAD f_txns
        TO VERTEX Card VALUES (
            $"derived_card_id",
            $"customer_id",
            $"card4",
            $"card6",
            $"card5"
        ),
        TO EDGE OWNS VALUES ($"customer_id", $"derived_card_id")
        WHERE $"derived_card_id" != "" AND $"customer_id" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";
}

// RUN LOADING JOB load_cards USING f_txns="../DATA/filtered_data/transactions_with_identity_filtered.csv"
