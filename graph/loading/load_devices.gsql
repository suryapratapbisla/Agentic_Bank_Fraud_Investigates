// ============================================================
// Entity: DeviceProfile only. Does not load Transaction.
//
// Source:
//   DATA/filtered_data/transactions_with_identity_filtered.csv
//   Identity columns (identity.csv header, kept by the merge):
//     DeviceType, DeviceInfo, id_30, id_31, id_33, id_23
//
// There is no device_hash column. The schema comment defines the
// key as DeviceType + DeviceInfo + OS (id_30). The "|" separator
// is only a join character for that derived id.
//
// TODO: device_status.
//   Schema comment says identity.csv id_12 or id_28.
//   DATA/readme.md says id_15 is New/Found.
//   All three columns exist. None is mapped until that is settled.
//   ignore_if_exists so a later choice is not cleared on re-run.
//
// In-person rows have an empty DeviceType after the left join.
// Those rows are skipped. FROM_DEVICE is loaded in this job
// because Transaction already exists. Re-run upserts the same
// device_hash and the same edge.
//
// Install:
//   gsql loading/load_devices.gsql
//
// Run from graph/:
//   RUN LOADING JOB load_devices USING f_txns="../DATA/filtered_data/transactions_with_identity_filtered.csv"
//   SHOW LOADING STATUS ALL
// ============================================================

USE GRAPH FraudInvestigationGraph

CREATE LOADING JOB load_devices FOR GRAPH FraudInvestigationGraph {
    DEFINE FILENAME f_txns = "/tmp/agentic_deploy/DATA/filtered_data/transactions_with_identity_filtered.csv";

    LOAD f_txns
        TO VERTEX DeviceProfile VALUES (
            gsql_concat($"DeviceType", "|", $"DeviceInfo", "|", $"id_30"),
            $"DeviceType",
            $"DeviceInfo",
            $"id_30",
            $"id_31",
            $"id_33",
            $"id_23",
            ""
        )
        WHERE $"DeviceType" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";

    LOAD f_txns
        TO EDGE FROM_DEVICE VALUES (
            $"TransactionID",
            gsql_concat($"DeviceType", "|", $"DeviceInfo", "|", $"id_30")
        )
        WHERE $"DeviceType" != "" AND $"TransactionID" != ""
        USING HEADER="true", SEPARATOR=",", QUOTE="double";
}

// RUN LOADING JOB load_devices USING f_txns="../DATA/filtered_data/transactions_with_identity_filtered.csv"
